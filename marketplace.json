{
  "$schema": "https://json.schemastore.org/claude-plugin-manifest.json",
  "name": "dual-repo-workspace-guard",
  "displayName": "Dual-Repo Workspace Guard & Doc Lifecycle",
  "version": "1.0.0",
  "description": "Reorganize mixed repositories into isolated dual-repo workspaces, install cross-repo anti-leak git guards, contract sync, and document lifecycle schemas across any project.",
  "author": {
    "name": "Mamdouh Aboammar",
    "url": "https://github.com/imMamdouhaboammar"
  },
  "homepage": "https://github.com/imMamdouhaboammar/dual-repo-workspace-guard",
  "repository": {
    "type": "git",
    "url": "https://github.com/imMamdouhaboammar/dual-repo-workspace-guard.git"
  },
  "license": "MIT",
  "categories": [
    "developer-tools",
    "automation",
    "security"
  ],
  "compatibility": {
    "claudeCode": ">=1.0.0",
    "claudeDesktop": ">=1.0.0",
    "cursor": ">=0.40.0",
    "codex": ">=0.1.0",
    "opencode": ">=1.0.0",
    "antigravity": ">=1.0.0"
  },
  "entrypoint": "SKILL.md",
  "bin": {
    "dual-repo-workspace-guard": "./bin/cli.js"
  }
}
